<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FsAzureStorage</RootNamespace>
    <Description>Total Commander FileSystem Plugin to manage Azure Blob Storage.</Description>
    <Nullable>enable</Nullable>
    
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.ResourceManager.Storage" Version="1.6.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageReference Include="MimeMapping" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DNNE" Version="2.0.8" />
    <ProjectReference Include="..\..\TcBuild\TcBuildTask\TcBuildTask.csproj" />
    <ProjectReference Include="..\..\TcBuild\TcPluginBase\TcPluginBase.csproj" />
    <ProjectReference Include="..\..\TcBuild\TcBuildGenerator\TcBuildGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\TcBuild\TcBuildTask\build\TcBuild.targets" />

</Project>